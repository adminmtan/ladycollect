# 复制成 .env 后填值

# 必填：JWT 签名密钥（≥32 字符随机字符串）
# 生成方法: openssl rand -hex 32
JWT_SECRET=replace-me-with-64-random-hex-chars

# 必填：默认管理员密码（≥8 位，首次启动后写入数据库）
# 启动一次后这个值就失效了；想改密码进 admin UI 改
ADMIN_PASSWORD=ChangeMe123!

# 可选：默认管理员账号（默认 admin）
ADMIN_USERNAME=admin

# 可选：时区（默认 Asia/Shanghai）
TZ=Asia/Shanghai

# 可选：日志级别
LOG_LEVEL=INFO

# 可选：GHCR 认证（仅当镜像为 private 时需要）
# GitHub Settings → Developer settings → Personal access tokens (fine-grained)
# 勾选: read packages
# GHCR_USERNAME=adminmtan
# GHCR_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
